<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the debug build only; adds android:networkSecurityConfig to
     the <application> tag so plain HTTP works for local backend testing.
     Never present in a release build. tools:replace is explicit here (rather
     than relying on default merge precedence) because the main manifest ALSO
     sets this same attribute now, to a different (narrower) config; being
     explicit avoids any ambiguity about which one wins for which build type. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig" />
</manifest>
