# Copy this file to keystore.properties (same folder) and fill in your real values.
# keystore.properties itself is gitignored -- never commit your real passwords.
#
# storeFile is relative to the repo root -- run the keytool command from the
# repo root (see README section 9) so the .jks file lands right next to this
# file. It's protected by .gitignore's *.jks pattern either way, but keeping
# it in this folder (rather than some other relative path) is the simplest
# thing to get right.
storeFile=fastvpn-release.jks
storePassword=CHANGE_ME
keyAlias=fastvpn
keyPassword=CHANGE_ME
