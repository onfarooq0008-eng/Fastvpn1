<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark-only design: NoActionBar (non-Light) MaterialComponents is the dark base. -->
    <style name="Theme.FastVPN" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSurface">@color/cardBackground</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Theme.FastVPN.Splash" parent="Theme.FastVPN">
        <item name="android:windowBackground">@color/launcherIconBg</item>
    </style>
    <style name="TextAppearance.FastVPN.Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
