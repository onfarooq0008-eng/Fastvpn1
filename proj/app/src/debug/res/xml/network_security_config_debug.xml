<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY (see app/src/debug/). Allows plain HTTP so you can test
     your control API before you've set up HTTPS. This file is never included
     in a release build; release enforces HTTPS by default (Android's
     standard behavior since API 28), which is required before publishing. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
